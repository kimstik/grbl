// samd21_grbl.repl - Renode platform description for the GRBL SAMD21 port
//
// Target: ATSAMD21G18A (Cortex-M0+, 48 MHz, 256 KB flash, 32 KB SRAM)
// Peripheral addresses follow grbl/platform/samd21/samd21.h.
//
// Modeled peripherals (all stock Renode models, no custom C#):
//   sercom3  UART.SAMD5_UART   @ 0x42001400 -> NVIC 12  (SERCOM USART register
//            layout is identical between SAMD21 and SAMD5 for the offsets the
//            port uses: CTRLA 0x00, CTRLB 0x04, BAUD 0x0C, INTENCLR 0x14,
//            INTENSET 0x16, INTFLAG 0x18, SYNCBUSY 0x1C, DATA 0x28)
//   portA/B  GPIOPort.SAMD21_GPIO
//   tc3/tc4  Timers.SAMD21_Timer (stepper + pulse-reset timers)
//
// Unmodeled peripherals are tagged so reads return a chosen constant:
//   SYSCTRL PCLKSR  -> 0x0000FFFF : SystemInit() busy-waits on OSC8MRDY (bit 3)
//                      and DFLLRDY (bit 4); Renode has no SYSCTRL model, so the
//                      ready bits are forced high (same trick as the bundled
//                      platforms/cpus/atsamd21j17d-aft.repl).
//   NVMCTRL INTFLAG -> 0x1 : nvmem.c busy-waits on the READY bit after each
//                      flash command. Commands themselves are no-ops; the page
//                      buffer writes land directly in the MappedMemory flash,
//                      which is sufficient for EEPROM-emulation reads/writes.
// Everything else in a tagged range reads as 0, which satisfies every other
// busy-wait in the port (GCLK/TC/TCC SYNCBUSY, SERCOM SWRST, EIC SYNCBUSY).

flash: Memory.MappedMemory @ sysbus 0x00000000
    size: 0x40000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x8000

// NVM Software Calibration Area (0x00806020). Reads return 0 -> DFLL48M
// coarse calibration of 0, which is irrelevant in emulation.
nvmcal: Memory.ArrayMemory @ sysbus 0x00806000
    size: 0x100

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    -> cpu@0
    systickFrequency: 48000000

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m0+"
    nvic: nvic
    init:
        PerformanceInMips 48

sercom3: UART.SAMD5_UART @ sysbus 0x42001400
    -> nvic@12

portA: GPIOPort.SAMD21_GPIO @ sysbus 0x41004400

portB: GPIOPort.SAMD21_GPIO @ sysbus 0x41004480

tc3: Timers.SAMD21_Timer @ sysbus 0x42002C00
    baseFrequency: 48000000
    IRQ -> nvic@18

tc4: Timers.SAMD21_Timer @ sysbus 0x42003000
    baseFrequency: 48000000
    IRQ -> nvic@19

// GCLK modeled as plain memory: writes are absorbed, STATUS (0x01) always
// reads 0 so SYNCBUSY waits fall through.
gclk: Memory.ArrayMemory @ sysbus 0x40000C00
    size: 0x20

sysbus:
    init:
        Tag <0x40000400 0x80> "PM"
        Tag <0x40000800 0x80> "SYSCTRL"
        Tag <0x4000080C 0x4> "SYSCTRL_PCLKSR" 0x0000FFFF
        Tag <0x40001000 0x10> "WDT"
        Tag <0x40001800 0x40> "EIC"
        Tag <0x41004000 0x14> "NVMCTRL"
        Tag <0x41004014 0x4> "NVMCTRL_INTFLAG" 0x00000001
        Tag <0x41004018 0x68> "NVMCTRL_STATUS_ADDR_LOCK"
        Tag <0x42002000 0x400> "TCC0"
        Tag <0x42002400 0x400> "TCC1"
        Tag <0x42002800 0x400> "TCC2"
